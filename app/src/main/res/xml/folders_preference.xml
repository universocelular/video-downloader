<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:defaultValue=""
        app:icon="@drawable/vd_pref_folder_music"
        app:key="music_path"
        app:title="@string/music_directory" />

    <Preference
        android:defaultValue=""
        app:icon="@drawable/vd_pref_folder_video"
        app:key="video_path"
        app:title="@string/video_directory" />

    <Preference
        android:defaultValue=""
        app:icon="@drawable/vd_setting_terminal"
        app:key="command_path"
        app:title="@string/command_directory" />

    <Preference
        android:defaultValue=""
        app:icon="@drawable/vd_setting_folders"
        app:key="cache_path"
        app:title="@string/cache_directory" />

    <Preference
        app:icon="@drawable/vd_setting_folders"
        app:key="access_all_files"
        android:summary="@string/access_all_directories_summary"
        app:title="@string/access_all_directories" />

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/preferece_material_switch"
        app:defaultValue="true"
        app:icon="@drawable/vd_pref_storage"
        app:key="check_available_storage"
        app:title="@string/check_available_storage" />

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/preferece_material_switch"
        app:defaultValue="true"
        app:icon="@drawable/vd_pref_rename"
        android:enabled="false"
        app:key="cache_downloads"
        app:summary="@string/cache_first_summary"
        app:title="@string/cache_first" />


    <SwitchPreferenceCompat
        android:widgetLayout="@layout/preferece_material_switch"
        app:defaultValue="false"
        android:icon="@drawable/vd_pref_save"
        android:key="no_part"
        app:summary="@string/no_download_fragments_summary"
        app:title="@string/no_download_fragments" />


    <SwitchPreferenceCompat
        android:widgetLayout="@layout/preferece_material_switch"
        app:defaultValue="false"
        android:icon="@drawable/vd_pref_save"
        android:key="keep_cache"
        app:summary="@string/keep_cache_summary"
        app:title="@string/keep_cache" />



    <Preference
        android:icon="@drawable/vd_pref_rename"
        app:key="file_name_template"
        app:useSimpleSummaryProvider="true"
        app:defaultValue="%(uploader).30B - %(title).170B"
        app:title="@string/file_name_template" />

    <Preference
        android:icon="@drawable/vd_pref_rename"
        app:key="file_name_template_audio"
        app:useSimpleSummaryProvider="true"
        app:defaultValue="%(uploader).30B - %(title).170B"
        app:title="@string/file_name_template" />

    <MultiSelectListPreference
        app:dialogTitle="@string/save_subdirectory"
        app:entries="@array/save_subdirectory"
        app:entryValues="@array/save_subdirectory_values"
        app:icon="@drawable/vd_pref_rename"
        app:key="save_subdirectory"
        app:summary="@string/save_subdirectory_summary"
        app:title="@string/save_subdirectory" />

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/preferece_material_switch"
        app:defaultValue="true"
        app:icon="@drawable/vd_pref_scissors"
        app:key="trim_filenames"
        app:title="@string/trim_filenames" />

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/preferece_material_switch"
        app:defaultValue="false"
        app:icon="@drawable/vd_pref_rename"
        app:key="restrict_filenames"
        app:summary="@string/restrict_filenames_summary"
        app:title="@string/restrict_filenames" />

    <Preference
        app:icon="@drawable/vd_pref_folder_x"
        app:key="temporary_files"
        app:title="@string/temporary_files" />

    <Preference
        app:icon="@drawable/vd_pref_reset"
        app:key="reset_preferences"
        android:summary="@string/reset_preferences_in_screen"
        app:title="@string/reset" />

</PreferenceScreen>