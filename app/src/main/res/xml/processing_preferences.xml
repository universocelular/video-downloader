<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/vd_ps_general">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_skip"
            app:key="use_sponsorblock"
            app:title="@string/vd_p_use_sponsorblock" />

        <MultiSelectListPreference
            app:icon="@drawable/vd_pref_skip"
            app:dialogTitle="@string/select_sponsorblock_filtering"
            app:entries="@array/sponsorblock_settings_entries"
            app:entryValues="@array/sponsorblock_settings_values"
            app:key="sponsorblock_filters"
            app:summary="@string/select_sponsorblock_filtering"
            app:title="SponsorBlock" />

        <EditTextPreference
            app:icon="@drawable/vd_pref_skip"
            app:key="sponsorblock_url"
            app:useSimpleSummaryProvider="true"
            app:defaultValue=""
            app:title="@string/vd_p_sponsorblock_url" />


        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_clock"
            app:key="mtime"
            app:summary="@string/vd_p_mtime_s"
            app:title="@string/vd_p_mtime" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_document"
            app:key="write_description"
            android:summary="@string/vd_p_write_description_s"
            app:title="@string/vd_p_write_description" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_setting_terminal"
            app:key="use_extra_commands"
            android:summary="@string/vd_p_use_extra_commands_s"
            app:title="@string/vd_p_use_extra_commands" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_scissors"
            app:key="force_keyframes"
            app:summary="@string/vd_p_force_keyframes_s"
            app:title="@string/vd_p_force_keyframes" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_setting_media"
            app:key="embed_metadata"
            app:summary="@string/vd_p_embed_metadata_s"
            app:title="@string/vd_p_embed_metadata" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/audio">
        <Preference
            android:icon="@drawable/vd_pref_hd"
            app:key="audio_bitrate"
            app:defaultValue=""
            android:summary="@string/defaultValue"
            app:title="@string/vd_p_audio_bitrate" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_pref_picture"
            app:key="embed_thumbnail"
            app:summary="@string/vd_p_embed_thumbnail_s"
            app:title="@string/vd_p_embed_thumbnail" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_pref_scissors"
            app:key="crop_thumbnail"
            app:summary="@string/vd_p_crop_thumbnail_s"
            app:title="@string/vd_p_crop_thumbnail" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_lyrics"
            app:key="embed_lyrics"
            app:summary="@string/vd_p_embed_lyrics_s"
            app:title="@string/vd_p_embed_lyrics" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_lyrics"
            app:key="save_lrc"
            app:summary="@string/vd_p_save_lrc_s"
            app:title="@string/vd_p_save_lrc" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_pref_album"
            app:key="playlist_as_album"
            app:summary="@string/vd_p_playlist_as_album_s"
            app:title="@string/vd_p_playlist_as_album" />

        <ListPreference
            app:icon="@drawable/vd_pref_language"
            app:dialogTitle="@string/preferred_audio_language"
            app:entries="@array/language_names"
            app:entryValues="@array/language_codes"
            app:key="audio_language"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_audio_language" />

        <ListPreference
            android:defaultValue=""
            android:entries="@array/audio_codec"
            android:entryValues="@array/audio_codec_values"
            android:icon="@drawable/vd_pref_code"
            app:useSimpleSummaryProvider="true"
            app:key="audio_codec"
            app:title="@string/vd_p_audio_codec" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_film"
            app:key="prefer_container_over_codec_audio"
            android:summary="@string/vd_p_prefer_container_over_codec_audio_s"
            app:title="@string/vd_p_prefer_container_over_codec_audio" />

        <ListPreference
            android:defaultValue=""
            android:entries="@array/audio_containers"
            android:entryValues="@array/audio_containers_values"
            android:icon="@drawable/vd_pref_code"
            app:key="audio_format"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_audio_format" />

        <EditTextPreference
            app:key="format_id_audio"
            app:defaultValue=""
            app:icon="@drawable/vd_pref_tag"
            app:summary="@string/vd_p_format_id_audio_s"
            app:title="@string/vd_p_format_id_audio" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_music"
            app:key="prefer_drc_audio"
            app:title="@string/vd_p_prefer_drc_audio" />

    </PreferenceCategory>


    <PreferenceCategory android:title="@string/video">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_pref_subtitles"
            app:key="embed_subtitles"
            app:summary="@string/vd_p_embed_subtitles_s"
            app:title="@string/vd_p_embed_subtitles" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_subtitles"
            app:key="write_subtitles"
            app:summary="@string/vd_p_write_subtitles_s"
            app:title="@string/vd_p_write_subtitles" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_subtitles"
            app:key="write_auto_subtitles"
            app:summary="@string/vd_p_write_auto_subtitles_s"
            app:title="@string/vd_p_write_auto_subtitles" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_pref_subtitles"
            app:key="no_keep_subs"
            app:summary="@string/vd_p_no_keep_subs_s"
            app:title="@string/vd_p_no_keep_subs" />

        <Preference
            android:icon="@drawable/vd_pref_subtitles"
            app:key="subs_lang"
            app:useSimpleSummaryProvider="true"
            app:defaultValue=".*-orig"
            app:title="@string/vd_p_subs_lang" />


        <ListPreference
            android:defaultValue=""
            android:entries="@array/sub_formats"
            android:entryValues="@array/sub_formats_values"
            android:icon="@drawable/vd_pref_quote"
            app:key="sub_format"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_sub_format" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_picture"
            app:key="write_thumbnail"
            app:summary="@string/vd_p_write_thumbnail_s"
            app:title="@string/vd_p_write_thumbnail" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_picture"
            app:key="video_embed_thumbnail"
            app:summary="@string/vd_p_video_embed_thumbnail_s"
            app:title="@string/vd_p_video_embed_thumbnail" />

        <ListPreference
            android:defaultValue="jpg"
            android:entries="@array/thumbnail_containers"
            android:entryValues="@array/thumbnail_containers_values"
            android:icon="@drawable/vd_pref_picture"
            app:key="thumbnail_format"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_thumbnail_format" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_pref_book"
            app:key="add_chapters"
            app:summary="@string/vd_p_add_chapters_s"
            app:title="@string/vd_p_add_chapters" />



        <ListPreference
            android:defaultValue=""
            android:entries="@array/video_containers"
            android:entryValues="@array/video_containers_values"
            android:icon="@drawable/vd_pref_code"
            app:key="video_format"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_video_format" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_setting_media"
            app:key="recode_video"
            android:summary="@string/vd_p_recode_video_s"
            app:title="@string/vd_p_recode_video" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_setting_media"
            app:key="compatible_video"
            android:summary="@string/vd_p_compatible_video_s"
            app:title="@string/vd_p_compatible_video" />


        <ListPreference
            android:defaultValue=""
            android:entries="@array/video_codec"
            android:entryValues="@array/video_codec_values"
            android:icon="@drawable/vd_pref_code"
            app:useSimpleSummaryProvider="true"
            app:key="video_codec"
            app:title="@string/vd_p_video_codec" />



        <ListPreference
            android:defaultValue="best"
            android:entries="@array/video_formats"
            android:entryValues="@array/video_formats_values"
            android:icon="@drawable/vd_pref_hd"
            app:key="video_quality"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_video_quality" />

        <EditTextPreference
            app:key="format_id"
            app:defaultValue=""
            app:icon="@drawable/vd_pref_tag"
            app:summary="@string/vd_p_format_id_s"
            app:title="@string/vd_p_format_id" />

        <ListPreference
            android:defaultValue=""
            android:entries="@array/internal_plugin_ffmpeg_preset"
            android:entryValues="@array/internal_plugin_ffmpeg_preset_values"
            android:icon="@drawable/vd_pref_speed"
            app:key="internal_plugin_ffmpeg_preset"
            android:summary="@string/vd_p_internal_plugin_ffmpeg_preset_s"
            app:title="@string/vd_p_internal_plugin_ffmpeg_preset" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_trash"
            app:key="remove_audio"
            app:title="@string/vd_p_remove_audio" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_music"
            app:key="also_download_audio"
            app:title="@string/vd_p_also_download_audio" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/vd_ps_format">

        <ListPreference
            app:icon="@drawable/vd_pref_film"
            app:dialogTitle="@string/preferred_format_size"
            app:entries="@array/preferred_format_size"
            app:entryValues="@array/preferred_format_size_values"
            android:defaultValue=""
            app:key="preferred_format_size"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_preferred_format_size" />

        <ListPreference
            app:icon="@drawable/vd_pref_film"
            app:dialogTitle="@string/preferred_format_size_audio"
            app:entries="@array/preferred_format_size"
            app:entryValues="@array/preferred_format_size_values"
            android:defaultValue=""
            app:key="preferred_format_size_audio"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_preferred_format_size_audio" />

    </PreferenceCategory>

    <Preference
        app:icon="@drawable/vd_pref_reset"
        app:key="reset_preferences"
        android:summary="@string/vd_p_reset_preferences_s"
        app:title="@string/vd_p_reset_preferences" />

</PreferenceScreen>