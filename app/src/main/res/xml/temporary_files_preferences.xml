<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.deniscerri.ytdl.ui.more.settings.folder.temporary.TemporaryFilesSummaryPreference
        app:key="temporary_files_summary" />

    <PreferenceCategory android:title="@string/temporary_files">

        <com.deniscerri.ytdl.ui.more.settings.folder.temporary.SizePreference
            app:icon="@drawable/vd_setting_downloads"
            app:key="temp_unfinished_downloads"
            app:summary="@string/vd_p_temp_unfinished_downloads_s"
            app:title="@string/vd_p_temp_unfinished_downloads" />

        <com.deniscerri.ytdl.ui.more.settings.folder.temporary.SizePreference
            app:icon="@drawable/vd_pref_code"
            app:key="temp_info_jsons"
            app:summary="@string/vd_p_temp_info_jsons_s"
            app:title="@string/vd_p_temp_info_jsons" />

        <com.deniscerri.ytdl.ui.more.settings.folder.temporary.SizePreference
            app:icon="@drawable/vd_setting_terminal"
            app:key="temp_ytdlp_cache"
            app:summary="@string/vd_p_temp_ytdlp_cache_s"
            app:title="@string/vd_p_temp_ytdlp_cache" />

        <com.deniscerri.ytdl.ui.more.settings.folder.temporary.SizePreference
            app:icon="@drawable/vd_pref_chip"
            app:key="temp_configs"
            app:summary="@string/vd_p_temp_configs_s"
            app:title="@string/vd_p_temp_configs" />

        <com.deniscerri.ytdl.ui.more.settings.folder.temporary.SizePreference
            app:icon="@drawable/vd_pref_phone_update"
            app:key="temp_downloaded_installers"
            app:summary="@string/vd_p_temp_downloaded_installers_s"
            app:title="@string/vd_p_temp_downloaded_installers" />

    </PreferenceCategory>

    <Preference
        app:icon="@drawable/vd_setting_folders"
        app:key="move_cache"
        android:summary="@string/vd_p_move_cache_s"
        app:title="@string/vd_p_move_cache" />

    <com.deniscerri.ytdl.ui.more.settings.folder.temporary.DangerButtonPreference
        app:key="clear_all_temporary_files"
        app:title="@string/vd_p_clear_all_temporary_files" />

</PreferenceScreen>
