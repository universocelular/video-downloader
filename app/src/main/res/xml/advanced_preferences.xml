<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="YouTube">
        <Preference
            android:defaultValue=""
            android:icon="@drawable/vd_pref_person"
            android:key="yt_player_client"
            android:summary="@string/vd_p_yt_player_client_s"
            android:title="@string/vd_p_yt_player_client" />

        <Preference
            android:defaultValue=""
            android:icon="@drawable/vd_pref_stars"
            android:key="generate_po_tokens"
            android:title="@string/vd_p_generate_po_tokens" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            android:icon="@drawable/vd_pref_language"
            android:defaultValue="false"
            android:summary="@string/vd_p_use_app_language_for_metadata_s"
            android:key="use_app_language_for_metadata"
            android:title="@string/vd_p_use_app_language_for_metadata" />

<!--        <EditTextPreference-->
<!--            android:defaultValue=""-->
<!--            android:icon="@drawable/vd_pref_code"-->
<!--            android:key="youtube_data_sync_id"-->
<!--            app:useSimpleSummaryProvider="true"-->
<!--            android:title="Data Sync ID" />-->

        <EditTextPreference
            android:defaultValue=""
            android:icon="@drawable/vd_pref_code"
            android:key="youtube_other_extractor_args"
            app:useSimpleSummaryProvider="true"
            android:title="@string/vd_p_youtube_other_extractor_args" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/vd_ps_command_templates">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            android:icon="@drawable/vd_setting_terminal"
            android:key="enable_data_fetching_extra_commands"
            android:summary="@string/vd_p_enable_data_fetching_extra_commands_s"
            android:title="@string/vd_p_enable_data_fetching_extra_commands" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/vd_ps_format">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_sort"
            app:key="use_format_sorting"
            app:title="@string/vd_p_use_format_sorting" />

        <Preference
            android:icon="@drawable/vd_pref_film"
            android:key="format_importance_video"
            app:title="@string/vd_p_format_importance_video" />

        <Preference
            android:icon="@drawable/vd_pref_film"
            android:key="format_importance_audio"
            app:title="@string/vd_p_format_importance_audio" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/vd_set_when_downloading">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            android:icon="@drawable/vd_pref_rename"
            android:key="disable_write_info_json"
            android:summary="@string/vd_p_disable_write_info_json_s"
            android:title="@string/vd_p_disable_write_info_json" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/vd_pref_shield"
            android:key="no_check_certificates"
            app:title="@string/vd_p_no_check_certificates" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/vd_pref_rename"
            android:key="use_header"
            app:title="@string/vd_p_use_header" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/vd_ps_misc">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            android:icon="@drawable/vd_setting_home"
            android:key="no_flat_playlist"
            android:summary="@string/vd_p_no_flat_playlist_s"
            android:title="@string/vd_p_no_flat_playlist" />


        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            android:icon="@drawable/vd_pref_parallel"
            android:key="use_original_url_playlist"
            android:summary="@string/vd_p_use_original_url_playlist_s"
            android:title="@string/vd_p_use_original_url_playlist" />
    </PreferenceCategory>

    <Preference
        app:allowDividerAbove="true"
        app:icon="@drawable/vd_pref_reset"
        app:key="reset_preferences"
        android:summary="@string/vd_p_reset_preferences_s"
        app:title="@string/vd_p_reset_preferences" />

</PreferenceScreen>