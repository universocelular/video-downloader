<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/vd_ps_appearance">
        <Preference
            android:icon="@drawable/vd_pref_language"
            app:key="app_language"
            app:persistent="false"
            app:summary=""
            app:title="@string/vd_p_app_language" />

        <ListPreference
            android:entries="@array/themes"
            android:entryValues="@array/themes_values"
            android:icon="@drawable/vd_pref_theme"
            app:defaultValue="System"
            app:key="ytdlnis_theme"
            app:summary="@string/defaultValue"
            app:title="@string/vd_p_ytdlnis_theme" />

        <Preference
            android:defaultValue="default"
            android:icon="@drawable/vd_pref_appicon"
            android:title="@string/vd_p_ytdlnis_icon"
            android:summary="@string/defaultValue"
            app:key="ytdlnis_icon" />

        <ListPreference
            android:entries="@array/accents"
            android:entryValues="@array/accents_values"
            android:icon="@drawable/vd_setting_appearance"
            app:defaultValue="violet"
            app:key="theme_accent"
            app:title="@string/vd_p_theme_accent" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/vd_pref_contrast"
            android:key="high_contrast"
            app:summary="@string/vd_p_high_contrast_s"
            app:title="@string/vd_p_high_contrast" />


        <MultiSelectListPreference
            app:icon="@drawable/vd_pref_image_off"
            app:dialogTitle="@string/hide_thumbnails"
            app:entries="@array/hide_thumbnail"
            app:entryValues="@array/hide_thumbnail_values"
            app:key="hide_thumbnails"
            app:title="@string/vd_p_hide_thumbnails" />

        <MultiSelectListPreference
            app:icon="@drawable/vd_pref_card"
            android:dialogTitle="@string/modify_download_card"
            android:entries="@array/modify_download_card"
            android:entryValues="@array/modify_download_card_values"
            android:defaultValue="@array/modify_download_card_values"
            app:key="modify_download_card"
            app:title="@string/vd_p_modify_download_card" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/vd_pref_layers"
            android:key="display_over_apps"
            app:isPreferenceVisible="false"
            app:summary="@string/vd_p_display_over_apps_s"
            app:title="@string/vd_p_display_over_apps" />


    </PreferenceCategory>

    <PreferenceCategory android:title="YouTube">
        <ListPreference
            android:icon="@drawable/vd_pref_heart"
            android:key="recommendations_home"
            android:defaultValue=""
            android:entries="@array/video_recommendations"
            android:entryValues="@array/video_recommnedations_values"
            app:summary="@string/vd_p_recommendations_home_s"
            app:title="@string/vd_p_recommendations_home" />

        <EditTextPreference
            android:icon="@drawable/vd_pref_heart"
            app:key="custom_home_recommendation_url"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:icon="@drawable/vd_pref_key"
            app:key="api_key"
            android:summary="@string/vd_p_api_key_s"
            app:title="@string/vd_p_api_key" />

        <ListPreference
            android:defaultValue="YT_DLP"
            android:entries="@array/data_fetching_extractor_youtube"
            android:entryValues="@array/data_fetching_extractor_youtube_values"
            android:icon="@drawable/vd_setting_home"
            app:key="youtube_data_fetching_extractor"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_youtube_data_fetching_extractor" />

        <ListPreference
            android:defaultValue="yt-dlp"
            android:entries="@array/formats_source"
            android:entryValues="@array/formats_source_values"
            android:icon="@drawable/vd_setting_home"
            app:key="formats_source"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_formats_source" />


        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/vd_pref_quote"
            app:key="use_itemurl_instead_playlisturl"
            app:summary="@string/vd_p_use_itemurl_instead_playlisturl_s"
            app:title="@string/vd_p_use_itemurl_instead_playlisturl" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/vd_ps_misc">
        <ListPreference
            android:defaultValue="share"
            android:entries="@array/history_quick_action_entries"
            android:entryValues="@array/history_quick_action_values"
            app:icon="@drawable/vd_pref_pencil"
            app:useSimpleSummaryProvider="true"
            app:key="history_quick_action"
            app:title="@string/vd_p_history_quick_action" />

        <ListPreference
            android:defaultValue=""
            android:entries="@array/countries"
            android:entryValues="@array/countries_values"
            app:icon="@drawable/vd_pref_language"
            app:useSimpleSummaryProvider="true"
            app:key="locale"
            app:title="@string/vd_p_locale" />

        <ListPreference
            android:defaultValue="always"
            android:entries="@array/label_visibility"
            android:entryValues="@array/label_visibility_values"
            android:icon="@drawable/vd_pref_eye"
            app:key="label_visibility"
            app:useSimpleSummaryProvider="true"
            app:title="@string/vd_p_label_visibility" />

        <ListPreference
            android:defaultValue="ytsearch"
            android:entries="@array/search_engines"
            android:entryValues="@array/search_engines_values"
            android:icon="@drawable/vd_setting_home"
            app:key="search_engine"
            app:summary="@string/vd_p_search_engine_s"
            app:title="@string/vd_p_search_engine" />


        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/vd_pref_clipboard"
            app:key="check_clipboard_home"
            app:summary="@string/vd_p_check_clipboard_home_s"
            app:title="@string/vd_p_check_clipboard_home" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/vd_setting_home"
            android:key="search_suggestions"
            app:summary="@string/vd_p_search_suggestions_s"
            app:title="@string/vd_p_search_suggestions" />

        <MultiSelectListPreference
            android:icon="@drawable/vd_pref_hand"
            android:key="swipe_gesture"
            android:entries="@array/swipe_gestures"
            android:entryValues="@array/swipe_gestures_values"
            android:defaultValue="@array/swipe_gestures_values"
            app:summary="@string/vd_p_swipe_gesture_s"
            app:title="@string/vd_p_swipe_gesture" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/vd_pref_hand"
            android:key="swipe_gestures_download_card"
            app:title="@string/vd_p_swipe_gestures_download_card" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/vd_pref_share"
            android:key="show_terminal"
            app:title="@string/vd_p_show_terminal" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/vd_pref_share"
            android:key="show_quick_download_share"
            app:title="@string/vd_p_show_quick_download_share" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/vd_pref_numbers"
            android:key="show_count_downloads"
            app:title="@string/vd_p_show_count_downloads" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/vd_pref_numbers"
            android:key="write_ytdlp_terminal"
            app:title="@string/vd_p_write_ytdlp_terminal" />


        <Preference
            app:icon="@drawable/vd_pref_battery"
            app:key="ignore_battery"
            app:title="@string/vd_p_ignore_battery" />

        <Preference
            app:icon="@drawable/vd_pref_reset"
            app:key="reset_preferences"
            android:summary="@string/vd_p_reset_preferences_s"
            app:title="@string/vd_p_reset_preferences" />

    </PreferenceCategory>

</PreferenceScreen>