<?xml version="1.0" encoding="utf-8"?>
<!-- "En curso | Listos" at the top of Archivos (diseño/imagenes/08-1-listos.png); FilesSelector wires it. -->
<com.google.android.material.button.MaterialButtonToggleGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/files_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    app:selectionRequired="true"
    app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/files_in_progress"
        style="@style/Widget.VideoDownloader.Button.Segment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/vd_files_in_progress" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/files_ready"
        style="@style/Widget.VideoDownloader.Button.Segment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/vd_files_ready" />

</com.google.android.material.button.MaterialButtonToggleGroup>
